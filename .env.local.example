# Copiar a `.env.local` y completar con los valores de la instancia.
# Ninguna de estas variables lleva prefijo NEXT_PUBLIC_: se leen solo en el
# servidor (lib/ y app/api/), así el endpoint y los IDs de Drive no viajan al
# navegador — a diferencia del prototipo, donde estaban hardcodeados en
# proto/sync.jsx y eran visibles para cualquiera.

# URL /exec del Apps Script desplegado sobre la planilla de esta instancia.
APPS_SCRIPT_URL=

# URL completa de la planilla de destino (se usa para el link "ver planilla").
SPREADSHEET_URL=

# Carpetas de Drive — flujo "Tomar foto".
DRIVE_FOTOS_POR_COMPLETAR=
DRIVE_FOTOS_PROCESADOS=

# Carpetas de Drive — facturas.
DRIVE_MANUAL_FACTURAS=
DRIVE_UPLOAD_FACTURAS=

# Carpeta de Drive — adjuntos del módulo Medidores.
DRIVE_MEDIDORES=
